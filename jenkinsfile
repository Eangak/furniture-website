
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        string(
            name: 'GIT_TAG',
            defaultValue: '1.0.0',
            description: 'Existing Git tag to build and deploy, e.g. 1.0.0 or v1.0.0'
        )
    }

    environment {
        GITHUB_REPOSITORY = 'https://github.com/Eangak/Furniture-Website.git'

        AWS_REGION        = 'us-east-1'
        AWS_ACCOUNT_ID    = '254209146027'
        ECR_REPOSITORY    = 'furniture-website'
        ECR_REGISTRY      = '254209146027.dkr.ecr.us-east-1.amazonaws.com'

        // CHANGE THIS to your Swarm manager's actual reachable IP or DNS name.
        SWARM_MANAGER_HOST = '52.207.224.147'
        SWARM_MANAGER_USER = 'ubuntu'

        STACK_NAME = 'furniture'
        STACK_FILE = 'docker-stack.yml'
    }

    stages {
        stage('Initialize') {
            steps {
                script {
                    env.IMAGE_TAG = params.GIT_TAG.trim()

                    if (!(env.IMAGE_TAG ==~ /[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}/)) {
                        error("Invalid Docker image tag: ${env.IMAGE_TAG}")
                    }

                    if (env.SWARM_MANAGER_HOST == 'REPLACE_WITH_MANAGER_IP') {
                        error('Set SWARM_MANAGER_HOST to your actual Swarm manager IP or DNS name.')
                    }

                    env.FULL_IMAGE =
                        "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.IMAGE_TAG}"

                    echo "Image to publish: ${env.FULL_IMAGE}"
                }
            }
        }

        stage('Checkout Code') {
            steps {
                deleteDir()

                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "refs/tags/${params.GIT_TAG}"]],
                    userRemoteConfigs: [[
                        url: "${env.GITHUB_REPOSITORY}"
                    ]]
                ])

                sh '''
                    set -eu
                    echo "Checked out commit:"
                    git rev-parse HEAD

                    test -f Dockerfile || {
                        echo "ERROR: Dockerfile not found in repository root"
                        exit 1
                    }

                    test -f docker-stack.yml || {
                        echo "ERROR: docker-stack.yml not found"
                        exit 1
                    }
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu
                    docker build --pull \
                      -t "$FULL_IMAGE" .
                    docker image inspect "$FULL_IMAGE" >/dev/null
                '''
            }
        }

        stage('Authenticate to ECR') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'aws-access-key-id',
                        variable: 'AWS_ACCESS_KEY_ID'
                    ),
                    string(
                        credentialsId: 'aws-secret-access-key',
                        variable: 'AWS_SECRET_ACCESS_KEY'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        export AWS_DEFAULT_REGION="$AWS_REGION"
                        export AWS_PAGER=""

                        aws sts get-caller-identity

                        aws ecr get-login-password \
                          --region "$AWS_REGION" |
                          docker login \
                            --username AWS \
                            --password-stdin "$ECR_REGISTRY"
                    '''
                }
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh '''
                    set -eu
                    docker push "$FULL_IMAGE"
                '''
            }
        }

        stage('Prepare Stack File') {
            steps {
                sh '''
                    set -eu

                    grep -q 'IMAGE_PLACEHOLDER' "$STACK_FILE" || {
                        echo "ERROR: IMAGE_PLACEHOLDER is missing from $STACK_FILE"
                        exit 1
                    }

                    sed -i \
                      "s|IMAGE_PLACEHOLDER|$FULL_IMAGE|g" \
                      "$STACK_FILE"

                    if grep -q 'IMAGE_PLACEHOLDER' "$STACK_FILE"; then
                        echo "ERROR: Image placeholder was not fully replaced"
                        exit 1
                    fi

                    echo "Prepared stack configuration:"
                    docker stack config -c "$STACK_FILE"
                '''
            }
        }

        stage('Deploy to Docker Swarm') {
            steps {
                sshagent(credentials: ['swarm-manager-ssh']) {
                    sh '''
                        set -eu

                        REMOTE="${SWARM_MANAGER_USER}@${SWARM_MANAGER_HOST}"
                        REMOTE_DIR="/home/${SWARM_MANAGER_USER}/furniture-website"

                        ssh -o StrictHostKeyChecking=accept-new \
                          "$REMOTE" \
                          "mkdir -p '$REMOTE_DIR'"

                        scp -o StrictHostKeyChecking=accept-new \
                          "$STACK_FILE" \
                          "$REMOTE:$REMOTE_DIR/docker-stack.yml"

                        ssh -o StrictHostKeyChecking=accept-new \
                          "$REMOTE" \
                          "AWS_DEFAULT_REGION='$AWS_REGION' \
                           aws ecr get-login-password \
                             --region '$AWS_REGION' |
                           docker login \
                             --username AWS \
                             --password-stdin '$ECR_REGISTRY' &&
                           docker stack deploy \
                             --with-registry-auth \
                             -c '$REMOTE_DIR/docker-stack.yml' \
                             '$STACK_NAME'"
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sshagent(credentials: ['swarm-manager-ssh']) {
                    sh '''
                        set -eu

                        REMOTE="${SWARM_MANAGER_USER}@${SWARM_MANAGER_HOST}"

                        ssh -o StrictHostKeyChecking=accept-new \
                          "$REMOTE" \
                          "docker stack services '$STACK_NAME' &&
                           docker service ps \
                             '${STACK_NAME}_furniture-website' \
                             --no-trunc"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completed. Published and deployed: ${env.FULL_IMAGE}"
        }

        failure {
            echo 'Pipeline failed. Review the stage logs before retrying.'
        }

        always {
            sh 'docker logout "$ECR_REGISTRY" >/dev/null 2>&1 || true'
        }
    }
}
